# Paste these into the app's Settings -> Secrets on Streamlit Community Cloud. Never commit a real secrets.toml.
APP_PASSWORD = "choose-a-long-password"
CRAWL_BACKEND = "local"          # no Docker on Streamlit Cloud: use the in-process Crawl4AI library
INSTALL_BROWSER = "1"            # download Playwright's Chromium on first start
CRAWL_MAX_PAGES_CAP = "15"       # small shared host: keep memory use low
ANONYMIZED_TELEMETRY = "false"
# Do NOT set ASKG1_* here: askg1 is on a private network and unreachable from the cloud (crawl-only mode).

# Copy to .env (never commit .env). Only askg1 is an AI provider; no OPENAI_/ANTHROPIC_/GOOGLE_ ... keys anywhere.
ASKG1_BASE_URL=http://127.0.0.1:8000/v1
ASKG1_MODEL=askg1
ASKG1_API_KEY=local-key

# askg1's real window. The PDF assumes 20000+; our askg1 serves 4096. Output and page-state caps scale from it.
ASKG1_CONTEXT_TOKENS=4096
ASKG1_MAX_OUTPUT_TOKENS=1024

# Telemetry off (PDF Step 6)
ANONYMIZED_TELEMETRY=false
BROWSER_USE_LOGGING_LEVEL=info

# UI password (the app refuses to start without it)
APP_PASSWORD=change-me


# Crawl4AI Docker service (PDF Step 7d). This is a service auth token, not an AI provider key.
# Needed because the current image only listens on loopback inside the container unless a token is set.
CRAWL4AI_API_TOKEN=generate-a-long-random-string
# auto = use the container if it answers, otherwise the in-process library; or force docker / local
CRAWL_BACKEND=auto
CRAWL4AI_URL=http://127.0.0.1:11235
